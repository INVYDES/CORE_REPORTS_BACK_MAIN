<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pasar el header Authorization a PHP. En IONOS (CGI/FastCGI) Apache lo
  # elimina por defecto, así que Sanctum recibía todas las peticiones sin
  # Bearer token y respondía 401 aunque la sesión fuera válida.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API: todo /api/* entra por api/index.php (Laravel vive fuera del docroot).
  # El !-f evita el bucle al reescribir api/index.php sobre sí mismo.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [L]

  # SPA fallback (Vue Router en history mode).
  # Nota: RewriteBase / y las rutas absolutas (/assets/...) de index.html asumen
  # que el sitio se sirve en la raíz del dominio (no en un subdirectorio).
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# No cachear el index.html: siempre debe referenciar los chunks con hash del
# último build (los assets sí pueden cachearse).
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>
