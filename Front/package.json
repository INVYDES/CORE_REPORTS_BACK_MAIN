    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.0",
    "jsdom": "^24.0.0",
    "logrocket": "^8.0.0",
    "postcss": "^8.5.6",
