includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: 9
    paths:
        - app
        - database
    excludePaths:
        - vendor
    # En PHPStan 2.x la antigua opción checkMissingIterableValueType se sustituye
    # por ignorar el identificador missingType.iterableValue.
    ignoreErrors:
        - identifier: missingType.iterableValue
